{"id":"wheresryan22/anatomy","url":"https://github.com/wheresryan22/anatomy","owner":"wheresryan22","name":"anatomy","description":"An agent skill for creating detailed, interactive isometric illustrations of real-world machines and complex systems. Generates polished SVGs with optional WebGL shaders and 3D effects.","description_source":"api","license":"MIT","topics":["agent-skill","open-source","svg","vizualization"],"archived":false,"pushed_at":"2026-10-15T14:14:32Z","language":"JavaScript","first_seen":"2026-10-12","last_seen":"2026-10-18","recommended":false,"recommend_count":0,"last_recommended":"2026-10-12","tier":"A","score":null,"risk":null,"source":null,"origin":"auto","kind":"plugin-skill","kind_basis":"topics/tags 含 plugin/skill","owner_class":"community","owner_label":null,"origin_note":"自动发现","action":null,"status":"active","drop_reason":null,"tags":{"领域":"AI","形态":"插件","用途":"提效","成熟度":"实验","上手难度":"轻配置","风险等级":"中"},"category":{"l1":"设计","l2":"UI设计"},"experience":{"stars":4,"score":76,"parts":{"易用性":18,"文档完整度":20,"功能成熟度":15,"维护活跃":13,"风险":10}},"tags_confidence":"inferred","stars":{"current":15454,"first":2041,"delta_total":13413,"delta_7d":0,"last_snapshot":null,"snapshots":0,"github":14935,"github_at":null,"forks":1139,"created_at":"2026-10-08T10:12:49Z","open_issues":null,"delta_7d_window_days":0,"delta_7d_valid":false},"events_count":1,"note":null,"user_notes":[],"human":{"status":"complete","one_liner":"这是一个给 Claude Code 用户用的绘图技能，可以帮你把抽象的技术概念画成能拆开、会动的立体机械图。","one_liner_src":"api+人工撰写","problem":"以前要给别人讲清楚「限流器怎么工作」，要么画很糙的方框图，要么花几小时找插画师；现在说一句话就能得到一张有零件感、能交互的立体图，拿来放文档或博客。","example":"比如你想解释「令牌桶限流」，输入一句话，它会画出一个带漏斗和刻度的机械装置，鼠标移上去还能拆成十来个零件看到内部结构。","feature_note":{"是什么":"一个 Claude Code 技能包，专门生成等距（isometric）视角的机械插画。","核心功能":["生成多零件、有明暗层次的等距 SVG 图","需要时叠加 WebGL 效果画火焰、水流、灯光","自带几何自检，保证零件不互相穿插、线条不悬空"],"常见用途":["给技术文档配图","写博客要首图","给非技术同事讲清架构"],"使用案例":["解释缓存命中流程","讲解连接池怎么复用","画一个 CDN 请求链路"],"不适合":["要标准折线图、饼图这类数据图表","不用 Claude Code 的人","需要精确定位的技术图纸"]},"audience":"用